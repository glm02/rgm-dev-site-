# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...sauf le gabarit, qui documente les variables attendues et ne contient
# aucun secret.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Skills d'agent
# `.agents/skills/` contient les vraies sources, versionnees.
# `.claude/skills/` n'est qu'un dossier de liens symboliques ABSOLUS recree par
# `npx skills add` : le committer casserait le depot sur toute autre machine.
/.claude/
